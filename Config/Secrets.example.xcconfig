// Secrets.example.xcconfig
//
// Committed template. Copy this file to Config/Secrets.xcconfig — which is gitignored —
// and replace the placeholder with your own key. Never commit the real one.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Carbon must launch and be fully usable with the placeholder value below. If RevenueCat
// fails to configure, the app logs it, sets entitlement state to .unknown, treats the user
// as free tier, and continues. Capture, extraction, review, the dataset and storage do not
// depend on RevenueCat succeeding. See docs/06-revenuecat-spec.md §4.
//
// Use a RevenueCat Test Store key here, not a production key. Test Store keys must never
// ship in a release build — the SDK deliberately alerts and crashes if a release build
// initialises with one.

REVENUECAT_API_KEY = test_REPLACE_ME
